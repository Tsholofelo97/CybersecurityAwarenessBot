<Window x:Class="CybersecurityAwarenessBotPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="720" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#EAF2FB"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header: Part 1 ASCII logo + title ===== -->
        <Border Grid.Row="0" Background="#1F4E79" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LogoText"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#9FD3FF"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                               FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="🛡 Stay safe online: chat, plan your security tasks, and test your knowledge"
                               FontSize="14" Foreground="#D6E9FF" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="10" FontSize="14">

            <!-- ===== TAB 1: Chat (Parts 1 + 2 + NLP) ===== -->
            <TabItem x:Name="ChatTab" Header="💬 Chat">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ChatDisplay"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14" Padding="8"
                             Background="White"/>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="UserInput"
                                 Height="36" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 KeyDown="UserInput_KeyDown"/>

                        <Button Grid.Column="1" Content="Send" Width="100"
                                Margin="8,0,0,0" Click="SendButton_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap"
                               Text="Try: “Add a task to enable two-factor authentication” · “Remind me to update my password tomorrow” · “Start the quiz” · “What have you done for me?” · “help”"/>
                </Grid>
            </TabItem>

            <!-- ===== TAB 2: Task Assistant (MySQL) ===== -->
            <TabItem x:Name="TasksTab" Header="✅ Tasks">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Add a cybersecurity task" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TaskTitleInput" Height="30" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TaskDescriptionInput" Height="90"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                        <CheckBox x:Name="UseReminderCheck" Content="Set a reminder for this task" Margin="0,12,0,6"/>
                        <TextBlock Text="Reminder date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ReminderPicker"/>

                        <Button Content="Add Task" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Click="AddTaskButton_Click"/>

                        <TextBlock x:Name="TaskStatusText" Margin="0,14,0,0"
                                   TextWrapping="Wrap" Foreground="#1F4E79"/>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Your tasks (saved in MySQL)" Style="{StaticResource SectionTitle}"/>

                        <DataGrid x:Name="TasksGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False"
                                  HeadersVisibility="Column" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"
                                                    ElementStyle="{StaticResource WrapCell}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"
                                                    ElementStyle="{StaticResource WrapCell}"/>
                                <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderText}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Mark Complete" Click="CompleteTaskButton_Click"/>
                            <Button Content="Set Reminder" ToolTip="Sets the date chosen on the left as the selected task's reminder"
                                    Click="SetReminderButton_Click"/>
                            <Button Content="Delete" Click="DeleteTaskButton_Click"/>
                            <Button Content="Refresh" Click="RefreshTasksButton_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== TAB 3: Cybersecurity Quiz ===== -->
            <TabItem x:Name="QuizTab" Header="🎯 Cyber Quiz">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="750" HorizontalAlignment="Left">
                        <TextBlock Text="Cybersecurity Quiz" Style="{StaticResource SectionTitle}"/>

                        <TextBlock x:Name="QuestionNumberText" FontWeight="SemiBold"
                                   Text="Press Start Quiz to begin. There are 12 questions."/>

                        <TextBlock x:Name="QuestionText" FontSize="17" TextWrapping="Wrap" Margin="0,12,0,12"/>

                        <RadioButton x:Name="OptionA" GroupName="QuizOptions" Margin="0,5" Visibility="Collapsed"/>
                        <RadioButton x:Name="OptionB" GroupName="QuizOptions" Margin="0,5" Visibility="Collapsed"/>
                        <RadioButton x:Name="OptionC" GroupName="QuizOptions" Margin="0,5" Visibility="Collapsed"/>
                        <RadioButton x:Name="OptionD" GroupName="QuizOptions" Margin="0,5" Visibility="Collapsed"/>

                        <WrapPanel Margin="0,16,0,0">
                            <Button x:Name="StartQuizButton" Content="Start Quiz" Click="StartQuizButton_Click"/>
                            <Button x:Name="SubmitAnswerButton" Content="Submit Answer" IsEnabled="False"
                                    Click="SubmitAnswerButton_Click"/>
                            <Button x:Name="NextQuestionButton" Content="Next Question" IsEnabled="False"
                                    Click="NextQuestionButton_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="QuizFeedbackText" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="15"/>
                        <TextBlock x:Name="QuizScoreText" FontWeight="Bold" Margin="0,8,0,0" FontSize="15"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== TAB 4: Activity Log ===== -->
            <TabItem x:Name="ActivityTab" Header="📋 Activity Log">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ActivityTitleText" Text="Recent activity (last 5)"
                               Style="{StaticResource SectionTitle}"/>

                    <ListBox x:Name="ActivityList" Grid.Row="1" FontSize="14" Background="White"/>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="Refresh" Click="RefreshActivityButton_Click"/>
                        <Button x:Name="ShowMoreButton" Content="Show More" Click="ShowMoreButton_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
